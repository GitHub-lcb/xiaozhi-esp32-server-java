# 复制为 .env 后生效：cp .env.example .env
# 不复制也能跑，docker-compose.yml 里每一项都有相同的默认值

XIAOZHI_TAG=latest       # 镜像版本，线上建议钉具体版本号，如 v6.2.0
# 镜像来源（compose 默认指向本仓 GHCR；镜像名必须全小写）
XIAOZHI_IMAGE_SERVER=ghcr.io/github-lcb/xiaozhi-server
XIAOZHI_IMAGE_DIALOGUE=ghcr.io/github-lcb/xiaozhi-dialogue
XIAOZHI_IMAGE_WEB=ghcr.io/github-lcb/xiaozhi-web

# ---- 端口 ----
WEB_PORT=8084            # 管理界面
SERVER_PORT=8091         # 后台 API + OTA
DIALOGUE_PORT=8092       # 设备 WebSocket
MYSQL_PORT=13306         # 只监听回环

# ---- 数据库 ----
MYSQL_DATABASE=xiaozhi
MYSQL_USER=xiaozhi
MYSQL_PASSWORD=123456
MYSQL_ROOT_PASSWORD=abc123456

# ---- 运行环境 ----
SPRING_PROFILES_ACTIVE=dev   # 生产改 prod
TZ=Asia/Shanghai

# 下发给设备的服务器 IP。Linux 可留空自动探测；
# macOS / Windows 的 Docker Desktop 探测不到局域网 IP，要手填，例如 192.168.1.100
HOST_IP=

# 设备接入鉴权密钥，留空等于不设防。对外部署前生成一个：openssl rand -hex 16
XIAOZHI_DEVICE_AUTH_SECRET=

# ---- 长期记忆 ----
# 会话结束时自动从对话里提炼记忆（每次都会调用一次大模型，按成本与隐私要求决定是否开启）
XIAOZHI_MEMORY_AUTO_EXTRACT=false

# ---- MQTT 设备通道（主动唤醒 / 主动推送）----
# 需要一台 broker（EMQX / Mosquitto）。关闭时设备继续走 WebSocket，主动下发类功能不可用
XIAOZHI_MQTT_ENABLED=false
XIAOZHI_MQTT_BROKER_URL=tcp://127.0.0.1:1883
# 下发给设备的 broker 地址，留空复用上面这条（Docker 内网地址设备访问不到时要单独配）
XIAOZHI_MQTT_PUBLIC_ENDPOINT=
XIAOZHI_MQTT_USERNAME=
XIAOZHI_MQTT_PASSWORD=
# 上下行主题模板，与固件约定一致时保持默认
XIAOZHI_MQTT_TOPIC_TEMPLATE=devices/p2p/{deviceId}

# ---- 联网搜索（DeepSeek 独立 Search API）----
# 不填 api-key 也能用：角色选的是 DeepSeek 模型时，自动复用模型配置里的 Key。
# 角色用其它模型、但想让设备也能联网搜索时，这里单独配一个 DeepSeek Key。
# 按成功请求计费，价格见 https://api-docs.deepseek.com/guides/search
XIAOZHI_SEARCH_API_KEY=
XIAOZHI_SEARCH_BASE_URL=https://api.deepseek.com
# 每次返回给模型的结果条数（语音场景 3~5 条足够，多了拖慢首字）
XIAOZHI_SEARCH_COUNT=5
XIAOZHI_SEARCH_TIMEOUT_SECONDS=8

# 运维令牌。配了之后 Prometheus 可以用 X-Ops-Token 头抓 /actuator/prometheus 与 /actuator/health，
# 不用登录态；留空则这两个端点也只认登录态。生成方式同上：openssl rand -hex 16
XIAOZHI_OPS_TOKEN=

# 对外域名。配了之后给设备下发的是
#   OTA  https://<domain>/api/device/ota
#   WS   wss://ws.<domain>/ws/xiaozhi/v1/
#   MCP  wss://mcp.<domain>/ws/mcp/
# 需要 <domain>、ws.<domain>、mcp.<domain> 都解析到本机并有可用证书；
# 留空则按探测到的 IP 走 http/ws，并带上 8091/8092 端口。
XIAOZHI_SERVER_DOMAIN=

# ---- 以下仅在从源码构建镜像时生效 ----
BUILD_PROXY=                        # 构建期下载代理，如 http://host.docker.internal:10808
VOSK_MODEL_SIZE=small               # 兜底识别模型：small / standard / none
TTS_MODEL=vits-melo-tts-zh_en       # 本地合成模型：vits-melo-tts-zh_en / matcha-icefall-zh-en / none
